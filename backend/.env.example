# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:4200

# Database
DATABASE_URL="postgresql://clinic_user:clinic_pass@localhost:5432/clinic_db?schema=public"

# Auth
JWT_ACCESS_SECRET=change-this-to-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-to-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=7d

# Throttling (requests per ttl window, in seconds)
THROTTLE_TTL=60
THROTTLE_LIMIT=100
